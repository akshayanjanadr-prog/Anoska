<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400">
  <defs>
    <radialGradient id="bg" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#2a2010"/>
      <stop offset="100%" stop-color="#080601"/>
    </radialGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#D4AF37" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="#D4AF37" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="400" height="400" fill="url(#bg)"/>
  <rect width="400" height="400" fill="url(#glow)"/>
  <!-- Vinyl grooves -->
  <circle cx="200" cy="200" r="190" fill="none" stroke="#C9A227" stroke-width="0.5" opacity="0.2"/>
  <circle cx="200" cy="200" r="150" fill="none" stroke="#C9A227" stroke-width="0.5" opacity="0.2"/>
  <circle cx="200" cy="200" r="110" fill="none" stroke="#C9A227" stroke-width="0.5" opacity="0.2"/>
  <circle cx="200" cy="200" r="70"  fill="none" stroke="#C9A227" stroke-width="0.5" opacity="0.2"/>
  <!-- Music note -->
  <text x="200" y="220" text-anchor="middle" font-size="80" fill="#D4AF37" opacity="0.4" font-family="serif">♫</text>
  <!-- Center circle -->
  <circle cx="200" cy="200" r="18" fill="#C9A227" opacity="0.8"/>
  <circle cx="200" cy="200" r="6"  fill="#0a0800"/>
  <!-- Border ring -->
  <circle cx="200" cy="200" r="195" fill="none" stroke="#D4AF37" stroke-width="1.5" opacity="0.3"/>
</svg>
